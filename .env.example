# ==========================================
# WAJIB DIISI - Bot Telegram (dari @BotFather)
# ==========================================
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# ID chat owner (dapatkan via @userinfobot)
TELEGRAM_DEVELOPER_CHAT_ID="your_chat_id_here"
TELEGRAM_OWNER_IDS="your_chat_id_here"

# ==========================================
# WAJIB DIISI - Telegram API (dari my.telegram.org)
# ==========================================
API_ID=12345678
API_HASH=your_api_hash_here

# ==========================================
# WAJIB DIISI - Database Neon PostgreSQL
# ==========================================
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ==========================================
# WAJIB DIISI - URL app setelah deploy ke Vercel
# ==========================================
APP_URL="https://your-project.vercel.app"

# ==========================================
# OPSIONAL
# ==========================================
# Enkripsi pesan OTP (32 karakter acak)
# OTP_ENCRYPTION_KEY="your_32_char_random_key_here"

# Secret untuk proteksi endpoint cron
# WEBHOOK_SECRET="random_secret_here"
